          "default": true,
          "hint": "开启时不出现在公开网站。写作完成后关闭此项再保存，才会正式发布。"
        },
        {
          "name": "comments",
          "label": "允许评论",
          "widget": "boolean",
          "default": true
        },
        {
          "name": "cover",
          "label": "封面图片",
          "widget": "image",
          "required": false
        },
        {
          "name": "coverSize",
          "label": "图片显示尺寸",
          "widget": "image_size",
          "source_field": "cover",
          "required": false
        },
        {
          "name": "coverAlt",
          "label": "封面图片说明",
          "widget": "string",
          "required": false
        },
        {
          "name": "coverCredit",
          "label": "封面来源链接",
          "widget": "string",
          "required": false,
          "pattern": [
            "^https?://[^\\s]+$",
            "填写完整的 HTTP 或 HTTPS 地址"
          ]
        },
        {
          "name": "_imageTools",
          "label": "正文图片",
          "widget": "image_tools",
          "required": false
        },
        {
          "name": "body",
          "label": "MDX 源码",
          "widget": "text",
          "hint": "保留 JSX 组件源码。此编辑器不渲染 MDX 交互组件；组件效果请在本地预览中检查。"
        }
      ]
    },
    {
      "name": "pages",
      "label": "介绍页面",
      "files": [
