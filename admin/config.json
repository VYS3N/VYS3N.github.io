          ]
        },
        {
          "name": "body",
          "label": "MDX 源码",
          "widget": "text",
          "hint": "保留 JSX 组件源码。此编辑器不渲染 MDX 交互组件；组件效果请在本地预览中检查。"
        }
      ]
    },
    {
      "name": "pages",
      "label": "介绍页面",
