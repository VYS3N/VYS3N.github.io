{
  "backend": {
    "name": "github",
    "repo": "VYS3N/vys3n-site-source",
    "branch": "main",
    "auth_methods": [
      "token"
    ]
  },
  "site_url": "https://vys3n.github.io",
  "display_url": "https://vys3n.github.io",
  "logo_url": "/favicon.svg",
  "media_folder": "content/media",
  "public_folder": "/media",
  "media_libraries": {
    "default": {
      "config": {
        "transformations": {
          "raster_image": {
            "format": "webp",
            "quality": 85
          }
        }
      }
    },
    "stock_assets": {
      "providers": [
        "pixabay",
        "unsplash"
      ]
    }
  },
  "output": {
    "omit_empty_optional_fields": true
  },
  "collections": [
    {
      "name": "posts",
      "label": "文章 · Markdown",
      "label_singular": "文章",
      "folder": "src/content/posts",
      "extension": "md",
      "format": "frontmatter",
      "create": true,
      "identifier_field": "slug",
      "slug": "{{slug}}",
      "preview_path": "blog/{{slug}}/",
      "summary": "{{title}} · {{date}}",
      "fields": [
        {
          "name": "title",
          "label": "文章标题",
          "widget": "string"
        },
        {
          "name": "slug",
          "label": "固定网址标识",
          "widget": "string",
          "pattern": [
            "^(?!all$)[a-z0-9][a-z0-9-]*$",
            "使用小写英文字母、数字和连字符；不能使用 all"
          ],
          "hint": "例如 first-post。发布后请保持不变。Markdown 和 MDX 文章也不能使用相同标识。"
        },
        {
          "name": "description",
          "label": "摘要",
          "widget": "text",
          "required": false
        },
        {
          "name": "date",
          "label": "发布时间",
          "widget": "datetime",
          "type": "datetime-local",
          "format": "YYYY-MM-DDTHH:mm:ssZ",
          "input_timezone": "Asia/Shanghai",
          "output_utc": false,
          "default": "{{now}}",
          "hint": "按北京时间填写日期和时分；首页按此时间从新到旧排列，同一天也会按时间排序。未来时间的文章会等到时间到达后构建发布。"
        },
        {
          "name": "updated",
          "label": "更新日期",
          "widget": "datetime",
          "type": "date",
          "format": "YYYY-MM-DD",
          "required": false
        },
        {
          "name": "tags",
          "label": "标签",
          "widget": "list",
          "required": false
        },
        {
          "name": "collection",
          "label": "所属合集",
          "widget": "relation",
          "collection": "series",
          "value_field": "slug",
          "display_fields": [
            "title.zh"
          ],
          "search_fields": [
            "title.zh",
            "title.en",
            "slug"
          ],
          "required": false,
          "multiple": false,
          "hint": "从站长创建的合集中选择；留空表示不加入合集。合集列表保存后会自动更新此选项。"
        },
        {
          "name": "order",
          "label": "合集内顺序",
          "widget": "number",
          "value_type": "int",
          "required": false,
          "min": 0
        },
        {
          "name": "lang",
          "label": "正文语言",
          "widget": "select",
          "default": "zh",
          "options": [
            {
              "label": "中文",
              "value": "zh"
            },
            {
              "label": "English",
              "value": "en"
            }
          ]
        },
        {
          "name": "draft",
          "label": "保留为草稿",
          "widget": "boolean",
          "default": true,
          "hint": "开启时不出现在公开网站。写作完成后关闭此项再保存，才会正式发布。"
        },
        {
          "name": "comments",
          "label": "允许评论",
          "widget": "boolean",
          "default": true
        },
        {
          "name": "cover",
          "label": "封面图片",
          "widget": "image",
          "required": false
        },
        {
          "name": "coverSize",
          "label": "图片显示尺寸",
          "widget": "image_size",
          "source_field": "cover",
          "required": false
        },
        {
          "name": "coverAlt",
          "label": "封面图片说明",
          "widget": "string",
          "required": false
        },
        {
          "name": "coverCredit",
          "label": "封面来源链接",
          "widget": "string",
          "required": false,
          "pattern": [
            "^https?://[^\\s]+$",
            "填写完整的 HTTP 或 HTTPS 地址"
          ]
        },
        {
          "name": "_markdownImport",
          "label": "导入文档",
          "widget": "markdown_import",
          "required": false
        },
        {
          "name": "_paragraphTools",
          "label": "正文排版",
          "widget": "paragraph_tools",
          "required": false
        },
        {
          "name": "_imageTools",
          "label": "正文图片",
          "widget": "image_tools",
          "required": false
        },
        {
          "name": "body",
          "label": "正文",
          "widget": "markdown",
          "modes": [
            "raw",
            "rich_text"
          ]
        }
      ]
    },
    {
      "name": "mdx",
      "label": "文章 · MDX 源码",
      "label_singular": "文章",
      "folder": "src/content/posts",
      "extension": "mdx",
      "format": "frontmatter",
      "create": true,
      "identifier_field": "slug",
