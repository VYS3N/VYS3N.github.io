    {
      "name": "song",
      "label": "音乐推荐管理",
      "folder": "src/data/songs",
      "extension": "json",
      "format": "json",
      "create": true,
      "delete": true,
      "duplicate": true,
      "identifier_field": "title",
      "slug": "{{slug}}",
      "summary": "{{title}} · {{artist}}",
      "table_columns": [
        "title",
        "artist",
        "enabled"
      ],
      "sortable_fields": [
        "title",
        "artist",
        "enabled"
      ],
      "fields": [
        {
          "name": "slug",
          "label": "歌曲固定标识",
          "widget": "string",
          "pattern": [
            "^[a-z0-9][a-z0-9-]*$",
            "使用小写英文字母、数字和连字符"
          ],
          "hint": "用于歌曲库文件名；创建后尽量保持不变。"
        },
        {
          "name": "title",
          "label": "歌曲名称",
          "widget": "string",
          "required": true,
          "hint": "必填；前台标题固定为 Song of the Moment。歌曲名称与歌手名称的组合不能重复。"
        },
        {
          "name": "artist",
          "label": "歌手名称",
          "widget": "string",
          "required": true
        },
        {
          "name": "enabled",
          "label": "启用歌曲",
          "widget": "boolean",
          "default": true,
          "hint": "关闭后保留在歌曲库中，但不会进入前台随机池。"
        },
        {
          "name": "album",
          "label": "专辑名称",
          "widget": "string",
          "required": false
        },
        {
          "name": "releaseDate",
          "label": "发行时间",
          "widget": "string",
          "required": false,
          "pattern": [
