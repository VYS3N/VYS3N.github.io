{
  "backend": {
    "name": "github",
    "repo": "VYS3N/vys3n-site-source",
    "branch": "main",
    "auth_methods": [
      "token"
    ]
  },
  "site_url": "https://vys3n.github.io",
  "display_url": "https://vys3n.github.io",
  "logo_url": "/favicon.svg",
  "media_folder": "content/media",
  "public_folder": "/media",
  "output": {
    "omit_empty_optional_fields": true
  },
  "collections": [
    {
      "name": "posts",
      "label": "文章 · Markdown",
      "label_singular": "文章",
      "folder": "src/content/posts",
      "extension": "md",
      "format": "frontmatter",
      "create": true,
      "identifier_field": "slug",
      "slug": "{{slug}}",
      "preview_path": "blog/{{slug}}/",
      "summary": "{{title}} · {{date}}",
      "fields": [
        {
          "name": "title",
          "label": "文章标题",
          "widget": "string"
        },
        {
          "name": "slug",
          "label": "固定网址标识",
          "widget": "string",
          "pattern": [
            "^(?!(all|tech|research|daily|journal)$)[a-z0-9][a-z0-9-]*$",
            "使用小写英文字母、数字和连字符；不能使用分类名称"
          ],
          "hint": "例如 first-post。发布后请保持不变。Markdown 和 MDX 文章也不能使用相同标识。"
        },
        {
          "name": "description",
          "label": "摘要",
          "widget": "text",
          "required": false
        },
        {
          "name": "date",
          "label": "发布日期",
          "widget": "datetime",
          "type": "date",
          "format": "YYYY-MM-DD",
          "default": "{{now}}",
          "hint": "按北京时间解释；未来日期的文章会等到日期到达后构建发布。"
        },
        {
          "name": "updated",
          "label": "更新日期",
          "widget": "datetime",
          "type": "date",
          "format": "YYYY-MM-DD",
          "required": false
        },
        {
          "name": "category",
          "label": "分类",
          "widget": "select",
          "default": "tech",
          "options": [
            {
              "label": "技术",
              "value": "tech"
            },
            {
              "label": "学习与思考",
              "value": "research"
            },
            {
              "label": "日常",
              "value": "daily"
            },
            {
              "label": "月记",
              "value": "journal"
            }
          ]
        },
        {
          "name": "tags",
          "label": "标签",
          "widget": "list",
          "required": false
        },
        {
          "name": "collection",
          "label": "所属合集",
          "widget": "string",
          "required": false,
          "pattern": [
            "^(?!all$|tech$|research$|daily$|journal$)[A-Za-z0-9㐀-䶿一-鿿][A-Za-z0-9㐀-䶿一-鿿-]*$",
            "支持中文、英文字母、数字和连字符；不能使用空格或斜线"
          ],
          "hint": "填写合集的网址标识；支持中文，例如 我的系列；不属于合集时留空。"
        },
        {
          "name": "order",
          "label": "合集内顺序",
          "widget": "number",
          "value_type": "int",
          "required": false,
          "min": 0
        },
        {
          "name": "lang",
          "label": "正文语言",
          "widget": "select",
          "default": "zh",
          "options": [
            {
              "label": "中文",
              "value": "zh"
            },
            {
              "label": "English",
              "value": "en"
            }
          ]
        },
        {
          "name": "draft",
          "label": "保留为草稿",
          "widget": "boolean",
          "default": true,
          "hint": "开启时不出现在公开网站。写作完成后关闭此项再保存，才会正式发布。"
        },
        {
          "name": "comments",
          "label": "允许评论",
          "widget": "boolean",
          "default": true
        },
        {
          "name": "cover",
          "label": "封面图片",
          "widget": "image",
          "required": false
        },
        {
          "name": "coverAlt",
          "label": "封面图片说明",
          "widget": "string",
          "required": false
        },
        {
          "name": "coverCredit",
          "label": "封面来源链接",
          "widget": "string",
          "required": false,
          "pattern": [
            "^https?://[^\\s]+$",
            "填写完整的 HTTP 或 HTTPS 地址"
          ]
        },
        {
          "name": "body",
          "label": "正文",
          "widget": "markdown"
        }
      ]
    },
    {
      "name": "mdx",
      "label": "文章 · MDX 源码",
      "label_singular": "文章",
      "folder": "src/content/posts",
      "extension": "mdx",
