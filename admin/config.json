          "options": [
            {
              "label": "技术",
              "value": "tech"
            },
            {
              "label": "学习与思考",
              "value": "research"
            },
            {
              "label": "日常",
              "value": "daily"
            },
            {
              "label": "月记",
              "value": "journal"
            }
          ]
        },
        {
          "name": "tags",
          "label": "标签",
