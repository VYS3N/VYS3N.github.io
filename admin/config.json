            {
              "label": "中文",
              "value": "zh"
            },
            {
              "label": "English",
              "value": "en"
            }
          ]
        },
        {
          "name": "draft",
          "label": "保留为草稿",
          "widget": "boolean",
          "default": true,
          "hint": "开启时不出现在公开网站。写作完成后关闭此项再保存，才会正式发布。"
        },
        {
          "name": "comments",
          "label": "允许评论",
          "widget": "boolean",
          "default": true
        },
        {
          "name": "cover",
          "label": "封面图片",
          "widget": "image",
          "required": false
        },
        {
          "name": "coverAlt",
          "label": "封面图片说明",
          "widget": "string",
          "required": false
        },
        {
          "name": "coverCredit",
          "label": "封面来源链接",
          "widget": "string",
          "required": false,
          "pattern": [
            "^https?://[^\\s]+$",
