---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { site, categoryKeys } from '../lib/data';
import { localized, t, url, type Lang } from '../lib/i18n';
interface Props { lang: Lang; path: string; title: string; description?: string; article?: boolean; image?: string; }
const { lang, path, title, description = localized(site.description, lang), article = false, image } = Astro.props;
const canonical = new URL(url(lang, path), site.url).href;
const otherLang = lang === 'zh' ? 'en' : 'zh';
const pageTitle = path ? `${title} · ${site.title}` : site.title;
const active = (prefix: string) => path === prefix || (prefix && path.startsWith(prefix + '/'));
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'} data-ui-lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#fafafa" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.title} />
    {image && <meta property="og:image" content={new URL(image, site.url).href} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <link rel="canonical" href={canonical} />
    {path !== '404' && <><link rel="alternate" hreflang="zh-CN" href={new URL(url('zh', path), site.url)} /><link rel="alternate" hreflang="en" href={new URL(url('en', path), site.url)} /></>}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`${site.title} RSS`} href="/rss.xml" />
    <script is:inline>
      try {
        const preference = localStorage.getItem('vys3n-theme') || 'system';
        const theme = preference === 'system' ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light') : preference;
        document.documentElement.dataset.theme = theme === 'dark' ? 'dark' : 'light';
        document.documentElement.dataset.themePreference = ['light', 'dark', 'system'].includes(preference) ? preference : 'system';
      } catch { document.documentElement.dataset.theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'; }
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t(lang, 'skip')}</a>
    <header class="site-header">
      <div class="header-inner site-width">
        <a class="brand" href={url(lang)} aria-label={`${site.title} ${t(lang, 'home')}`}>{site.title}<span class="brand-slash" aria-hidden="true">/</span></a>
        <nav class="desktop-nav" aria-label={t(lang, 'menu')}>
          <a class:list={{ active: active('about') }} href={url(lang, 'about')}>{t(lang, 'about')}</a>
          <a class:list={{ active: active('academic') || active('projects') }} href={url(lang, 'academic')}>{t(lang, 'academic')}</a>
          <details class="nav-dropdown"><summary class:list={{ active: active('blog') }}><span>{t(lang, 'blog')}</span><Icon name="chevron-down" size={13} /></summary><div class="dropdown-panel"><a href={url(lang, 'blog/all')}>{t(lang, 'all')}</a>{categoryKeys.map(key => <a href={url(lang, 'blog/' + key)}>{t(lang, key)}</a>)}<div class="dropdown-divider"></div><a href={url(lang, 'archives')}>{t(lang, 'archives')}</a><a href={url(lang, 'tags')}>{t(lang, 'tags')}</a><a href={url(lang, 'collection')}>{t(lang, 'collections')}</a></div></details>
          <a class:list={{ active: active('links') }} href={url(lang, 'links')}>{t(lang, 'links')}</a>
        </nav>
        <div class="header-actions">
          <a class="icon-button search-toggle" href={url(lang, 'search')} aria-label={t(lang, 'search')} title={t(lang, 'search')}><Icon name="search" size={18} /></a>
          <a class="icon-button language-switch" href={url(otherLang, path === '404' ? '' : path)} hreflang={otherLang} aria-label={`${lang === 'zh' ? 'EN' : '中'} / ${t(lang, 'language')}`} title={t(lang, 'language')}><Icon name="language" size={18} /><span>{lang === 'zh' ? 'EN' : '中'}</span></a>
          <button class="icon-button theme-toggle" type="button" data-theme-toggle data-label={t(lang, 'theme')} data-light={t(lang, 'light')} data-dark={t(lang, 'dark')} data-system={t(lang, 'system')} aria-label={t(lang, 'theme')}><span data-theme-icon="light"><Icon name="sun" size={18} /></span><span data-theme-icon="dark"><Icon name="moon" size={18} /></span><span data-theme-icon="system"><Icon name="device-desktop" size={18} /></span></button>
          <button class="icon-button mobile-menu-toggle" type="button" data-menu-toggle aria-label={t(lang, 'menu')} aria-controls="mobile-nav" aria-expanded="false"><Icon name="menu-2" size={20} /></button>
        </div>
      </div>
      <nav id="mobile-nav" class="mobile-nav site-width" aria-label={t(lang, 'menu')} hidden>
        {[['about', 'about'], ['academic', 'academic'], ['projects', 'projects'], ['blog/all', 'all'], ['archives', 'archives'], ['tags', 'tags'], ['collection', 'collections'], ['links', 'links'], ['search', 'search']].map(([href, key]) => <a href={url(lang, href)}>{t(lang, key as Parameters<typeof t>[1])}</a>)}
      </nav>
    </header>
    <main id="main" class:list={['site-width', 'main-content', { 'article-main': article }]}><slot /></main>
    <footer class="site-footer site-width"><div class="footer-line"><p>© {new Date().getFullYear()} {site.name}<span class="footer-separator">/</span><a href={url(lang, 'terms/list')}>{t(lang, 'policy')}</a><span class="footer-separator">/</span><a href="/admin/">{t(lang, 'admin')}</a></p><div class="footer-actions"><a href={`https://github.com/${site.github}`} target="_blank" rel="noopener noreferrer" aria-label="GitHub"><Icon name="brand-github" size={19} /></a><a href="/rss.xml" aria-label={t(lang, 'rss')} title={t(lang, 'rss')}><Icon name="rss" size={18} /></a></div></div></footer>
    <button class="back-top icon-button" data-back-top type="button" aria-label={t(lang, 'backTop')} title={t(lang, 'backTop')} hidden><Icon name="arrow-up" size={20} /></button>
    <div class="toast" data-toast role="status" aria-live="polite" hidden></div>
    <dialog class="media-dialog" data-media-dialog><button type="button" class="icon-button dialog-close" data-close-dialog aria-label={t(lang, 'close')}><Icon name="x" /></button><div data-dialog-content></div></dialog>
    <script src="../scripts/site.ts"></script>
  </body>
</html>
