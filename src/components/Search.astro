---
import { t, type Lang } from '../lib/i18n';
import Icon from './Icon.astro';
const { lang } = Astro.props as { lang: Lang };
---
<div class="page-heading"><h1>{t(lang, 'search')}</h1><p class="page-description">{t(lang, 'searchIntro')}</p></div>
<div class="search-page" data-search-root data-lang={lang} data-loading={t(lang, 'searchLoading')} data-error={t(lang, 'searchError')} data-empty={t(lang, 'searchEmpty')} data-empty-detail={t(lang, 'searchEmptyDetail')} data-results={t(lang, 'results')} data-min-read={t(lang, 'minRead')}>
  <form class="search-form" role="search"><label class="sr-only" for="search-input">{t(lang, 'search')}</label><Icon name="search" size={21} /><input id="search-input" name="q" type="search" placeholder={t(lang, 'searchPlaceholder')} autocomplete="off" enterkeyhint="search" /><button type="submit" class="button small">{t(lang, 'search')}</button></form>
  <p class="search-status muted" role="status" aria-live="polite" data-search-status></p>
  <div data-search-results class="search-results"></div>
</div>
<script src="../scripts/search.ts"></script>
