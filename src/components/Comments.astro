---
import { site } from '../lib/data';
import { t, type Lang } from '../lib/i18n';
interface Props { lang: Lang; path: string; enabled?: boolean; }
const { lang, path, enabled = true } = Astro.props;
const server = /^https:\/\//.test(site.walineServer) ? site.walineServer.replace(/\/$/, '') : '';
---
<section id="comments" class="comments-section section-block" data-waline-server={enabled ? server : ''} data-waline-path={path} data-waline-lang={lang} data-loading={t(lang, 'commentsLoading')} data-error={t(lang, 'commentsError')} data-retry={t(lang, 'retry')}>
  <h2>{t(lang, 'comments')}</h2>
  {enabled && server ? <div class="comment-loader"><p class="comment-status" role="status"></p><button type="button" class="button subtle" data-load-comments>{t(lang, 'loadComments')}</button><div data-comment-mount></div></div> : <p class="muted comment-closed">{t(lang, 'commentsClosed')}</p>}
</section>
