---
import type { Route, Post } from '../lib/data';
import { categoryKeys, pageSize, tagGroups, tagSlug, allSeries, seriesPosts, formatDate, postUrl } from '../lib/data';
import { t, url, localized, type Message } from '../lib/i18n';
import Icon from './Icon.astro';
import Empty from './Empty.astro';
import PostList from './PostList.astro';
const { route, posts } = Astro.props as { route: Route; posts: Post[] };
const { lang } = route;
const category = route.category || 'all';
const selectedPosts = route.kind === 'tag' ? posts.filter(p => p.data.tags.includes(route.tag!)) : route.kind === 'collection' ? seriesPosts(posts, route.series!.slug) : category === 'all' ? posts : posts.filter(p => p.data.category === category);
const page = route.page || 1;
const pages = Math.max(1, Math.ceil(selectedPosts.length / pageSize));
const pagePosts = route.kind === 'listing' ? selectedPosts.slice((page - 1) * pageSize, page * pageSize) : selectedPosts;
const tags = tagGroups(posts);
const series = allSeries(posts);
const groups = new Map<number, Post[]>();
for (const post of posts) { const year = post.data.date.getFullYear(); groups.set(year, [...(groups.get(year) || []), post]); }
---
<div class="page-heading"><h1>{route.title}</h1>{['listing', 'tag', 'collection'].includes(route.kind) && <p class="page-description">{selectedPosts.length} {t(lang, 'countUnit')}{route.kind === 'collection' && route.series && localized(route.series.description, lang) ? ` / ${localized(route.series.description, lang)}` : ''}</p>}</div>
{route.kind === 'listing' && <nav class="category-nav" aria-label={t(lang, 'blog')}>{['all', ...categoryKeys].map(key => <a href={url(lang, 'blog/' + key)} aria-current={category === key ? 'page' : undefined} class:list={{ selected: category === key }}>{t(lang, key as Message)}</a>)}</nav>}
{['listing', 'tag', 'collection'].includes(route.kind) && <>
  {pagePosts.length ? <PostList posts={pagePosts} lang={lang} /> : <Empty title={t(lang, 'noPosts')} detail={t(lang, 'noPostsDetail')} />}
  {route.kind === 'listing' && pages > 1 && <nav class="pagination" aria-label={t(lang, 'page')}>
    {page > 1 ? <a href={url(lang, `blog/${category}${page === 2 ? '' : '/' + (page - 1)}`)} rel="prev"><Icon name="arrow-left" size={16} />{t(lang, 'newer')}</a> : <span></span>}
    <span>{page} {t(lang, 'of')} {pages}</span>
    {page < pages ? <a href={url(lang, `blog/${category}/${page + 1}`)} rel="next">{t(lang, 'older')}<Icon name="arrow-right" size={16} /></a> : <span></span>}
  </nav>}
  <nav class="browse-links" aria-label={t(lang, 'blog')}><a href={url(lang, 'archives')}><Icon name="calendar" size={16} />{t(lang, 'archives')}</a><a href={url(lang, 'tags')}><Icon name="hash" size={16} />{t(lang, 'tags')}</a><a href={url(lang, 'collection')}><Icon name="books" size={16} />{t(lang, 'collections')}</a><a href="/rss.xml"><Icon name="rss" size={16} />RSS</a></nav>
</>}
{route.kind === 'archives' && (posts.length ? <div class="archive-list">{[...groups].map(([year, yearPosts]) => <section class="archive-year"><div class="archive-year-heading"><h2>{year}</h2><span>{yearPosts.length} {t(lang, 'countUnit')}</span></div><div>{yearPosts.map(post => <article class="archive-row"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time><a href={postUrl(post, lang)}>{post.data.title}</a></article>)}</div></section>)}</div> : <Empty title={t(lang, 'noPosts')} detail={t(lang, 'noPostsDetail')} icon="calendar" />)}
{route.kind === 'tags' && (tags.length ? <div class="tag-cloud">{tags.map(([tag, taggedPosts]) => <a href={url(lang, 'tags/' + tagSlug(tag))}><Icon name="hash" size={15} /><span>{tag}</span><span class="tag-count">{taggedPosts.length}</span></a>)}</div> : <Empty title={t(lang, 'tags')} detail={t(lang, 'noTags')} icon="hash" />)}
{route.kind === 'collections' && (series.length ? <div class="collections-grid">{series.map(item => <a class="collection-card" href={url(lang, 'collection/' + item.slug)}><Icon name="books" size={23} /><h2>{localized(item.title, lang)}</h2><p>{localized(item.description, lang)}</p><div><span>{seriesPosts(posts, item.slug).length} {t(lang, 'countUnit')}</span><Icon name="arrow-up-right" size={18} /></div></a>)}</div> : <Empty title={t(lang, 'collections')} detail={t(lang, 'noCollections')} icon="books" />)}
