---
import 'katex/dist/katex.min.css';
import { render } from 'astro:content';
import { type Post, site, postUrl, postSlug, formatDate, readTime, tagSlug, seriesPosts, allSeries } from '../lib/data';
import { type Lang, t, url, localized } from '../lib/i18n';
import Toc from './Toc.astro';
import Icon from './Icon.astro';
import Comments from './Comments.astro';
import PostList from './PostList.astro';
import * as writing from './writing';
const { post, posts, lang } = Astro.props as { post: Post; posts: Post[]; lang: Lang };
const { Content, headings } = await render(post);
const position = posts.findIndex(item => item.id === post.id);
const previous = posts[position + 1];
const next = posts[position - 1];
const related = posts.filter(item => item.id !== post.id).map(item => ({ item, score: item.data.tags.filter(tag => post.data.tags.includes(tag)).length + (item.data.category === post.data.category ? 1 : 0) })).filter(item => item.score > 0).sort((a, b) => b.score - a.score).slice(0, 3).map(item => item.item);
const series = post.data.collection ? allSeries(posts).find(item => item.slug === post.data.collection) : undefined;
const inSeries = series ? seriesPosts(posts, series.slug) : [];
const commentPath = url('zh', 'blog/' + postSlug(post));
---
<div class="reading-progress" aria-hidden="true"></div>
<header class="article-heading">
  <a class="back-link" href={url(lang, 'blog/all')}><Icon name="arrow-left" size={15} />{t(lang, 'backBlog')}</a>
  <div class="post-meta"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time>{post.data.updated && <span>{t(lang, 'modified')} {formatDate(post.data.updated, lang)}</span>}<span>{readTime(post)} {t(lang, 'minRead')}</span></div>
  <h1>{post.data.title}</h1>
  {post.data.description && <p class="article-description">{post.data.description}</p>}
  <div class="article-tags">{post.data.tags.map(tag => <a href={url(lang, 'tags/' + tagSlug(tag))}>#{tag}</a>)}</div>
  {site.walineServer && <div class="article-counters post-meta" data-view-server={site.walineServer} data-view-path={commentPath}><span><span class="waline-pageview-count" data-path={commentPath}></span> {t(lang, 'views')}</span>{post.data.comments && <a href="#comments"><span class="waline-comment-count" data-path={commentPath}></span> {t(lang, 'replies')}</a>}</div>}
</header>
{post.data.cover && <figure class="article-cover"><img src={post.data.cover} alt={post.data.coverAlt} width="1200" height="675" fetchpriority="high" />{post.data.coverCredit && <figcaption><a href={post.data.coverCredit} target="_blank" rel="noopener noreferrer">{t(lang, 'source')}<Icon name="arrow-up-right" size={13} /></a></figcaption>}</figure>}
<div class:list={['article-grid', { 'without-toc': !headings.some(heading => heading.depth > 1 && heading.depth < 5) }]}>
  <Toc headings={headings} lang={lang} />
  <div class="reading-column">
    <article class="prose article-body" lang={post.data.lang === 'zh' ? 'zh-CN' : 'en'} data-article-body data-copy-label={t(lang, 'copyLink')} data-copied={t(lang, 'copied')} data-copy-failed={t(lang, 'copyFailed')} data-image-label={t(lang, 'fullImage')}><Content components={writing} /></article>
    <div class="article-attribution"><div><span class="author-monogram">V</span><span>{site.name}<small>{t(lang, 'original')}</small></span></div><p>{t(lang, 'copyrightNote')}</p></div>
    <div class="article-share"><span>{t(lang, 'share')}</span><button class="button subtle small" data-copy-link data-copied={t(lang, 'copied')} data-copy-failed={t(lang, 'copyFailed')}><Icon name="link" size={16} />{t(lang, 'copyLink')}</button><button class="button subtle small" data-share-qr data-qr-hint={t(lang, 'qrHint')}><Icon name="qrcode" size={17} />{t(lang, 'qr')}</button></div>
    {series && <section class="series-navigation section-block"><div class="section-heading"><h2>{t(lang, 'inCollection')}</h2><a class="quiet-link" href={url(lang, 'collection/' + series.slug)}>{localized(series.title, lang)}<Icon name="arrow-up-right" size={14} /></a></div><ol>{inSeries.map(item => <li class:list={{ current: item.id === post.id }}>{item.id === post.id ? <span aria-current="page">{item.data.title}</span> : <a href={postUrl(item, lang)}>{item.data.title}</a>}</li>)}</ol></section>}
    {(previous || next) && <nav class="adjacent-posts" aria-label={t(lang, 'blog')}><div>{previous && <a href={postUrl(previous, lang)} rel="prev"><span><Icon name="arrow-left" size={14} />{t(lang, 'previous')}</span><strong>{previous.data.title}</strong></a>}</div><div>{next && <a href={postUrl(next, lang)} rel="next"><span>{t(lang, 'next')}<Icon name="arrow-right" size={14} /></span><strong>{next.data.title}</strong></a>}</div></nav>}
    {related.length > 0 && <section class="section-block"><h2>{t(lang, 'related')}</h2><PostList posts={related} lang={lang} /></section>}
    <Comments lang={lang} path={commentPath} enabled={post.data.comments} />
  </div>
</div>
