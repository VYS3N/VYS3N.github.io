---
import Assets from './Assets.astro';
import { writingLang } from '../../lib/writing';
interface Props { value: string; caption?: string; size?: number; }
const { value, caption, size = 200 } = Astro.props;
const lang = writingLang(Astro.url);
---
<Assets />
<figure class="writing-qr" data-writing-qr data-qr-value={value} data-qr-size={Math.max(128, Math.min(320, Math.floor(size)))}>
  <div data-qr-mount></div>
  <figcaption>{caption && <span>{caption}</span>}<code>{value}</code></figcaption>
  <div class="writing-service-status"><span data-qr-status role="status"></span><button class="writing-text-button" data-qr-retry type="button" hidden>{lang === 'zh' ? '重试' : 'Retry'}</button></div>
</figure>
