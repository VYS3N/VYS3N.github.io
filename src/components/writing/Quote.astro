---
import Assets from './Assets.astro';
import { writingHref, externalLink } from '../../lib/writing';
interface Props { author?: string; source?: string; href?: string; }
const { author, source, href } = Astro.props;
const target = href ? writingHref(href) : undefined;
const external = !!target && externalLink(target);
---
<Assets />
<figure class="writing-quote"><blockquote><slot /></blockquote>{(author || source) && <figcaption>{author && <span>{author}</span>}{source && <cite>{target ? <a href={target} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>{source}</a> : source}</cite>}</figcaption>}</figure>
