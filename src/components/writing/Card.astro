---
import Assets from './Assets.astro';
import Icon from '../Icon.astro';
import { writingHref, writingMedia, externalLink } from '../../lib/writing';
interface Props { title: string; href?: string; description?: string; image?: string; alt?: string; icon?: string; }
const { title, href, description, image, alt = '', icon } = Astro.props;
const target = href ? writingHref(href) : undefined;
const external = !!target && externalLink(target);
---
<Assets />
<article class="writing-card">
  {image && <img class="writing-card-image" src={writingMedia(image)} alt={alt} loading="lazy" width="640" height="360" />}
  <div class="writing-card-body">
    <p class="writing-card-title">{icon && <Icon name={icon} size={20} />}{target ? <a href={target} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>{title}<Icon name={external ? 'arrow-up-right' : 'arrow-right'} size={15} /></a> : <strong>{title}</strong>}</p>
    {description && <p class="writing-card-description">{description}</p>}
    <slot />
  </div>
</article>
