---
import Assets from './Assets.astro';
import Icon from '../Icon.astro';
import { writingLang } from '../../lib/writing';
interface Props { type?: 'note' | 'tip' | 'warning' | 'caution'; title?: string; }
const { type = 'note', title } = Astro.props;
const labels = { zh: { note: '提示', tip: '小技巧', warning: '注意', caution: '请留意' }, en: { note: 'Note', tip: 'Tip', warning: 'Warning', caution: 'Caution' } };
const icons = { note: 'info-circle', tip: 'bulb', warning: 'alert-triangle', caution: 'alert-circle' };
---
<Assets />
<aside class="writing-callout" data-kind={type}>
  <p class="writing-callout-title"><Icon name={icons[type]} size={19} /><strong>{title || labels[writingLang(Astro.url)][type]}</strong></p>
  <div class="writing-callout-content"><slot /></div>
</aside>
