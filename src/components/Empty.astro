---
import Icon from './Icon.astro';
interface Props { title: string; detail?: string; icon?: string; compact?: boolean; }
const { title, detail, icon = 'file-text', compact = false } = Astro.props;
---
<div class:list={['empty-state', { compact }]}>
  <span class="empty-icon"><Icon name={icon} size={25} /></span>
  <p class="empty-title">{title}</p>
  {detail && <p class="empty-detail">{detail}</p>}
  <slot />
</div>
